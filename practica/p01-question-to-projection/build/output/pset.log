. *==========================================================================
. * TASK 4 . Many draws, then the response graph and its caption   (Exercises 6-7)
. *==========================================================================
. display as text _n "Monte Carlo: R = `R' samples for each rho"

Monte Carlo: R = 500 samples for each rho

. timer clear 22

. timer on 22

. tempname MC

. postfile `MC' rep double rho h double(b_ctrl b_noctrl) n_ctrl n_noctrl ///
>     using "output/pset/mc_draws.dta", replace
(file output/pset/mc_draws.dta not found)

. foreach rho in 0.5 0.9 {
  2.     set seed 3                                   // once for each rho, outside the loop
  3.     quietly forvalues r = 1/`R' {
  4.         clear
  5.         set obs 300
  6.         generate t = _n
  7.         tsset t
  8.         generate s = rnormal()                   // all of s first,
  9.         generate v = rnormal()                   // then all of v
 10.         generate y = .
 11.         replace y = s + v in 1                   // y_0 = 0
 12.         replace y = `rho'*L.y + s + v in 2/300
 13.         drop if t <= 100                         // burn-in of 100 periods
 14.         replace t = _n
 15.         tsset t
 16.         forvalues h = 0/12 {
 17.             regress F`h'.y s L.y
 18.             local b_c = _b[s]
 19.             local n_c = e(N)
 20.             regress F`h'.y s
 21.             post `MC' (`r') (`rho') (`h') (`b_c') (_b[s]) (`n_c') (e(N))
 22.         }
 23.     }
 24. }

. postclose `MC'

. timer off 22

. quietly timer list 22

. display as text "Monte Carlo runtime: " as result %7.2f r(t22) as text " seconds for R = `R'"
Monte Carlo runtime:   70.79 seconds for R = 500

. 
. use "output/pset/mc_draws.dta", clear

