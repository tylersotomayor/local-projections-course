pass  Task 4: 199 - h rows with the control and 200 - h without

. foreach m in 200 500 {
  2.     if `R' >= `m' {
  3.         preserve
  4.         keep if rep <= `m'
  5.         generate double theta_h = rho^h
  6.         collapse (mean) theta_h mean_ctrl=b_ctrl mean_noctrl=b_noctrl      ///
>                  (sd) sd_ctrl=b_ctrl sd_noctrl=b_noctrl                    ///
>                  (p5) p5=b_ctrl (p95) p95=b_ctrl, by(rho h)
  7.         generate double bias = mean_ctrl - theta_h
  8.         generate double mcse = sd_ctrl/sqrt(`m')
  9.         generate R = `m'
 10.         format theta_h mean_* sd_* p5 p95 bias mcse %9.6f
 11.         display as text _n "Summary of the first `m' samples"
 12.         list rho h theta_h mean_ctrl bias mcse sd_ctrl p5 p95 mean_noctrl sd_noctrl, clean noobs
 13.         save "output/pset/mc_R`m'_summary.dta", replace
 14.         restore
 15.     }
 16. }
