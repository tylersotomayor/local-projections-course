. *==========================================================================
. * TASK 2 . Estimate the slopes from the rows                (Exercises 3-4)
. *==========================================================================
. import delimited using "`handfile'", clear
(encoding automatically selected: ISO-8859-2)
(4 vars, 12 obs)

. tsset t

Time variable: t, 1 to 12
        Delta: 1 unit

. tempname E

. postfile `E' h double(ybar1 ybar0 b_hand b_reg b_ctrl) byte same_rows ///
>     using "output/pset/results_hand_slopes.dta", replace
(file output/pset/results_hand_slopes.dta not found)

. forvalues h = 0/2 {
  2.     generate double yh = F`h'.y
  3.     generate byte inrow = (t >= 2 & yh < .)
  4. 
.     quietly summarize yh if inrow & s == 1
  5.     local ybar1 = r(mean)
  6.     quietly summarize yh if inrow & s == 0
  7.     local ybar0 = r(mean)
  8. 
.     quietly summarize s if inrow
  9.     local sbar = r(mean)
 10.     generate double num = (s - `sbar')*yh if inrow
 11.     generate double den = (s - `sbar')^2 if inrow
 12.     quietly summarize num
 13.     local sum_num = r(sum)
 14.     quietly summarize den
 15.     local b_hand = `sum_num'/r(sum)
 16. 
.     quietly regress F`h'.y s if t >= 2
 17.     local b_reg = _b[s]
 18.     quietly count if e(sample) != inrow
 19.     local mismatch = r(N)
 20.     quietly regress F`h'.y s L.y if t >= 2
 21.     local b_ctrl = _b[s]
 22.     quietly count if e(sample) != inrow
 23.     local same_rows = (`mismatch' + r(N) == 0)
 24. 
.     post `E' (`h') (`ybar1') (`ybar0') (`b_hand') (`b_reg') (`b_ctrl') (`same_rows')
 25.     drop yh inrow num den
 26. }
