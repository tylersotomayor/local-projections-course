.     if "`rows4'" == "drop1950q3" local keep "if qdate != tq(1950q3)"
.     if "`rows4'" == "dropboth"   local keep "if qdate != tq(1941q4) & qdate != tq(1950q3)"
.     if "`rows4'" == "from1947q1" local keep "if qdate >= tq(1947q1)"
. 
.     quietly regress F`h4'.y newsy `control'
